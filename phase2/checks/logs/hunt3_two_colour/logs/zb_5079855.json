{"result":{"biographic_references":[],"contributors":{"authors":[{"aliases":[],"checked":"1","codes":["harborth.heiko"],"name":"Harborth, Heiko"},{"aliases":[],"checked":"0","codes":["krause.stefan"],"name":"Krause, Stefan"}],"author_references":[],"editors":[]},"database":"Zbl","datestamp":"2006-12-12T13:29:50Z","document_type":{"code":"j","description":"journal article"},"editorial_contributions":[{"language":"English","reviewer":{"author_code":"halbeisen.lorenz-j","reviewer_id":"11245","name":"Lorenz Halbeisen","sign":"Lorenz Halbeisen (Bern)"},"text":"Assume that the vertices of the complete graph \\(K_n\\) are labeled by \\(1,2,\\dots,n\\). A \\(2\\)-coloring \\(\\pi\\) of the edges \\(E_n\\) of \\(K_n\\) is called a distance coloring if for all \\((n,m), (k,l)\\in E_n\\), \\(| n-m| =| k-l| \\rightarrow \\pi(n,m)= \\pi(k,l)\\). For given graphs \\(G\\) and \\(H\\) the distance Ramsey number RD\\((G,H)\\) is defined as the minimum \\(n\\) such that every distance coloring of \\(K_n\\) contains a monochromatic copy of \\(G\\) or \\(H\\). In the paper, for small graphs the values of RD\\((G,H)\\) are determined by computer and some lower bounds of classical Ramsey numbers are improved.","contribution_type":"review"}],"id":5079855,"identifier":"1112.05069","keywords":["Ramsey numbers","distance coloring"],"language":{"languages":["English"],"addition":[null]},"license":[],"links":[],"msc":[{"code":"05C55","scheme":"msc2020","text":"Generalized Ramsey theory"}],"references":[],"source":{"book":[],"pages":"197-200","series":[{"acronym":null,"issn":[{"number":"0315-3681","type":"print"}],"issue":null,"issue_id":185702,"parallel_title":null,"part":null,"publisher":"Combinatorial Press, Winnipeg, MB","series_id":752,"short_title":"Util. Math.","title":"Utilitas Mathematica","volume":"70","year":"2006"}],"source":"Util. Math. 70, 197-200 (2006)."},"states":[["c","is cited"]],"title":{"addition":null,"original":null,"subtitle":null,"title":"Distance Ramsey numbers"},"year":"2006","zbmath_url":"https://zbmath.org/5079855"},"status":{"execution":"successful request","execution_bool":true,"internal_code":"ok","last_id":null,"nr_total_results":1,"nr_request_results":1,"query_execution_time_in_seconds":0.03580141067504883,"status_code":200,"time_stamp":"2026-11-08T01:13:04Z"}}